# FlyGPT v0.7.1 generator configuration
#
# Point these at any OpenAI-compatible chat-completions endpoint.
# Example local Ollama endpoint:
# FLYGPT_GENERATOR_URL=http://127.0.0.1:11434/v1/chat/completions
# FLYGPT_GENERATOR_MODEL=llama3.2:3b
# FLYGPT_GENERATOR_PROVIDER=ollama
#
# Hosted providers can use the same fields. Keep real API keys out of Git.

FLYGPT_GENERATOR_URL=
FLYGPT_GENERATOR_MODEL=
FLYGPT_GENERATOR_PROVIDER=compatible-http
FLYGPT_GENERATOR_API_KEY=
FLYGPT_GENERATOR_TIMEOUT=45
FLYGPT_GENERATOR_TEMPERATURE=0.35
FLYGPT_GENERATOR_MAX_TOKENS=512

# Optional FlyWire data override
# FLYWIRE_DATA_DIR=/path/to/flywire_parts

# Optional router checkpoint override
# FLYGPT_MODEL_PATH=artifacts/fly_router_v0_3_9.pt

# Optional browser-session memory database path
# FLYGPT_MEMORY_PATH=data/flygpt_memory.sqlite3
