# FlyGPT v0.8.1 generator configuration
#
# Gemini 3.8 Flash quick setup:
# Add only GEMINI_API_KEY and `make run` will automatically use
# Google's OpenAI-compatible endpoint with low reasoning effort.
# Keep the real key only in .env. Never commit it.
GEMINI_API_KEY=

# Optional generator overrides. Leave these blank to use the Gemini preset
# when GEMINI_API_KEY is present, or fill them for another compatible provider.
FLYGPT_GENERATOR_URL=
FLYGPT_GENERATOR_MODEL=
FLYGPT_GENERATOR_PROVIDER=
FLYGPT_GENERATOR_API_KEY=
FLYGPT_GENERATOR_REASONING_EFFORT=
FLYGPT_GENERATOR_FALLBACK_MODEL=
FLYGPT_GENERATOR_RETRY_DELAY=0.6
FLYGPT_GENERATOR_TIMEOUT=45
FLYGPT_GENERATOR_TEMPERATURE=0.35
FLYGPT_GENERATOR_MAX_TOKENS=512

# Optional Adaptive Intelligence / second provider.
# Harder prompts can be promoted here while casual prompts stay on the
# standard generator above. The smart provider can use a completely different
# OpenAI-compatible endpoint and API key.
FLYGPT_SMART_GENERATOR_URL=
FLYGPT_SMART_GENERATOR_MODEL=
FLYGPT_SMART_GENERATOR_PROVIDER=
FLYGPT_SMART_GENERATOR_API_KEY=
FLYGPT_SMART_GENERATOR_REASONING_EFFORT=
FLYGPT_SMART_GENERATOR_TEMPERATURE=0.25
FLYGPT_SMART_GENERATOR_MAX_TOKENS=1536

# Janelia neuPrint / MaleCNS v1.0
# Create a neuPrint account/token and keep the real token out of Git.
NEUPRINT_TOKEN=
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0

# Optional router checkpoint override
# FLYGPT_MODEL_PATH=artifacts/fly_router_malecns_v0_4.pt

# Optional browser-session memory database path
# FLYGPT_MEMORY_PATH=data/flygpt_memory.sqlite3

# Local account/auth database
# FLYGPT_AUTH_PATH=data/flygpt_auth.sqlite3

# Set to 1 behind HTTPS in production so the auth cookie is Secure.
# FLYGPT_COOKIE_SECURE=0
